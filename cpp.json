			"}",
			"template<typename T1,typename T2>",
			"inline T1 fpow(T1 a,T2 b,T1 p){",
			"\tT1 ans{1};a%=p;",
			"\twhile(b){",
			"\t\tif(b&1)(ans*=a)%=p;",
			"\t\t(a*=a)%=p;",
			"\t\tb>>=1;",
			"\t}",
			"\treturn ans;",
			"}"
		],
