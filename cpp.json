			"template<typename T1,typename T2>",
			"inline T1 fpow(T1 a,T2 b){",
			"\tT1 ans{1};",
			"\twhile(b){",
			"\t\tif(b&1)ans*=a;",
			"\t\ta*=a;",
			"\t\tb>>=1;",
			"\t}",
