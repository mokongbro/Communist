{
	"poly": {
		"prefix": "poly",
		"body": [
			"#include<vector>",
			"#include<map>",
			"#include<string>",
			"#include<algorithm>",
			"#include<cmath>",
			"#include<cstdio>",
			"#include<type_traits>",
			"#include<numeric>",
			"#include<initializer_list>",
			"template<typename T=__int128>",
			"class Bint{",
			"\tpublic:",
			"\tstatic constexpr T base=1000000000;",
			"\tstd::vector<T>dt{};",
			"\tbool sig{};",
			"\tBint():dt{0},sig{}{}",
			"\tBint(const T&t):dt{},sig{}{",
			"\t\tsig=t<0;",
			"\t\t__int128 x{t<0?-(__int128)t:(__int128)t};",
			"\t\tdo{dt.push_back((T)(x%base));x/=base;}while(x);",
			"\t}",
			"\tBint(const std::string&s):dt{},sig{}{",
			"\t\tfor(char c:s){",
			"\t\t\tif(c=='-'){sig=1;continue;}",
			"\t\t\t__int128 carry{c-'0'};",
			"\t\t\tfor(size_t i=0;carry||i<dt.size();i++){",
			"\t\t\t\tif(i==dt.size())dt.push_back({});",
			"\t\t\t\t__int128 cur{dt[i]*10+carry};",
			"\t\t\t\tdt[i]=(T)(cur%base);",
			"\t\t\t\tcarry=cur/base;",
			"\t\t\t}",
			"\t\t}",
			"\t\treload();",
			"\t}",
			"\tvoid reload(){",
			"\t\twhile(dt.size()>1&&!dt.back())dt.pop_back();",
			"\t\tif(dt.empty())dt.push_back({});",
			"\t\tif(dt.size()==1&&!dt[0])sig=0;",
			"\t}",
			"\texplicit operator bool()const{return dt.size()>1||dt[0];}",
			"\tstatic bool abs_less(const Bint&x,const Bint&y){",
			"\t\tif(x.dt.size()!=y.dt.size())return x.dt.size()<y.dt.size();",
			"\t\tfor(size_t i=x.dt.size();i--;)",
			"\t\t\tif(x.dt[i]!=y.dt[i])return x.dt[i]<y.dt[i];",
			"\t\treturn false;",
			"\t}",
			"\tstatic Bint abs_add(const Bint&a,const Bint&b){",
			"\t\tBint t{};",
			"\t\tt.dt.resize(std::max(a.dt.size(),b.dt.size())+1);",
			"\t\t__int128 carry{};",
			"\t\tfor(size_t i=0;i<t.dt.size();i++){",
			"\t\t\t__int128 cur{carry};",
			"\t\t\tif(i<a.dt.size())cur+=a.dt[i];",
			"\t\t\tif(i<b.dt.size())cur+=b.dt[i];",
			"\t\t\tt.dt[i]=(T)(cur%base);",
			"\t\t\tcarry=cur/base;",
			"\t\t}",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tstatic Bint abs_sub(const Bint&a,const Bint&b){",
			"\t\tBint t{};",
			"\t\tt.dt.resize(a.dt.size());",
			"\t\t__int128 carry{};",
			"\t\tfor(size_t i=0;i<a.dt.size();i++){",
			"\t\t\t__int128 cur{a.dt[i]-carry-(i<b.dt.size()?b.dt[i]:0)};",
			"\t\t\tif(cur<0)cur+=base,carry=1;",
			"\t\t\telse carry=0;",
			"\t\t\tt.dt[i]=(T)cur;",
			"\t\t}",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tstatic Bint mul_small(const Bint&a,__int128 c){",
			"\t\tBint t{};",
			"\t\tt.dt.assign(a.dt.size()+1,{});",
			"\t\t__int128 carry{};",
			"\t\tfor(size_t i=0;i<a.dt.size();i++){",
			"\t\t\t__int128 cur{a.dt[i]*c+carry};",
			"\t\t\tt.dt[i]=(T)(cur%base);",
			"\t\t\tcarry=cur/base;",
			"\t\t}",
			"\t\tt.dt[a.dt.size()]=(T)carry;",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tstatic void divmod(const Bint&a,const Bint&b,Bint&q,Bint&r){",
			"\t\tq.dt.clear();r.dt.clear();q.sig=0;r.sig=0;",
			"\t\tfor(size_t i=a.dt.size();i--;){",
			"\t\t\tr.dt.insert(r.dt.begin(),a.dt[i]);",
			"\t\t\tr.reload();",
			"\t\t\t__int128 c{};",
			"\t\t\tif(!abs_less(r,b)){",
			"\t\t\t\t__int128 R{r.dt.back()},B{b.dt.back()};",
			"\t\t\t\tif(r.dt.size()>1)R=R*base+r.dt[r.dt.size()-2];",
			"\t\t\t\tif(b.dt.size()>1)B=B*base+b.dt[b.dt.size()-2];",
			"\t\t\t\t__int128 lo{R/(B+1)},hi{base-1};",
			"\t\t\t\tif(lo<1)lo=1;",
			"\t\t\t\twhile(lo<hi){",
			"\t\t\t\t\t__int128 mid{(lo+hi+1)>>1};",
			"\t\t\t\t\tif(abs_less(r,mul_small(b,mid)))hi=mid-1;",
			"\t\t\t\t\telse lo=mid;",
			"\t\t\t\t}",
			"\t\t\t\tc=lo;",
			"\t\t\t\tr=abs_sub(r,mul_small(b,c));",
			"\t\t\t}",
			"\t\t\tq.dt.insert(q.dt.begin(),(T)c);",
			"\t\t}",
			"\t\tq.reload();r.reload();",
			"\t\tif(q)q.sig=a.sig!=b.sig;",
			"\t\tif(r)r.sig=a.sig;",
			"\t}",
			"\tfriend Bint operator+(const Bint&a,const Bint&b){",
			"\t\tBint t{};",
			"\t\tif(a.sig==b.sig)t=abs_add(a,b),t.sig=a.sig;",
			"\t\telse if(abs_less(a,b))t=abs_sub(b,a),t.sig=b.sig;",
			"\t\telse t=abs_sub(a,b),t.sig=a.sig;",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tBint&operator+=(const Bint&x){",
			"\t\t*this=*this+x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Bint operator-(const Bint&a){",
			"\t\tBint t{a};",
			"\t\tif(t)t.sig=!t.sig;",
			"\t\treturn t;",
			"\t}",
			"\tfriend Bint operator-(const Bint&a,const Bint&b){",
			"\t\treturn a+(-b);",
			"\t}",
			"\tBint&operator-=(const Bint&x){",
			"\t\t*this=*this-x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Bint operator*(const Bint&a,const Bint&b){",
			"\t\tBint t{};",
			"\t\tt.dt.assign(a.dt.size()+b.dt.size(),{});",
			"\t\tfor(size_t i=0;i<a.dt.size();i++){",
			"\t\t\t__int128 carry{};",
			"\t\t\tfor(size_t j=0;j<b.dt.size();j++){",
			"\t\t\t\t__int128 cur{(__int128)a.dt[i]*b.dt[j]+t.dt[i+j]+carry};",
			"\t\t\t\tt.dt[i+j]=(T)(cur%base);",
			"\t\t\t\tcarry=cur/base;",
			"\t\t\t}",
			"\t\t\tfor(size_t j=i+b.dt.size();carry;j++){",
			"\t\t\t\t__int128 cur{t.dt[j]+carry};",
			"\t\t\t\tt.dt[j]=(T)(cur%base);",
			"\t\t\t\tcarry=cur/base;",
			"\t\t\t}",
			"\t\t}",
			"\t\tt.sig=a.sig!=b.sig;",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tBint&operator*=(const Bint&x){",
			"\t\t*this=*this*x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Bint operator/(const Bint&a,const Bint&b){",
			"\t\tBint q{},r{};",
			"\t\tdivmod(a,b,q,r);",
			"\t\treturn q;",
			"\t}",
			"\tBint&operator/=(const Bint&x){",
			"\t\t*this=*this/x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Bint operator%(const Bint&a,const Bint&b){",
			"\t\tBint q{},r{};",
			"\t\tdivmod(a,b,q,r);",
			"\t\treturn r;",
			"\t}",
			"\tBint&operator%=(const Bint&x){",
			"\t\t*this=*this%x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend bool operator<(const Bint&a,const Bint&b){",
			"\t\tif(a.sig!=b.sig)return a.sig;",
			"\t\treturn a.sig?abs_less(b,a):abs_less(a,b);",
			"\t}",
			"\tfriend bool operator<=(const Bint&a,const Bint&b){",
			"\t\treturn !(b<a);",
			"\t}",
			"\tfriend bool operator==(const Bint&a,const Bint&b){",
			"\t\treturn a.sig==b.sig&&a.dt==b.dt;",
			"\t}",
			"\tfriend bool operator!=(const Bint&a,const Bint&b){",
			"\t\treturn !(a==b);",
			"\t}",
			"\tfriend bool operator>=(const Bint&a,const Bint&b){",
			"\t\treturn !(a<b);",
			"\t}",
			"\tfriend bool operator>(const Bint&a,const Bint&b){",
			"\t\treturn b<a;",
			"\t}",
			"};",
			"template<typename T=Bint<__int128>>",
			"class Frac{",
			"\tpublic:",
			"\tT a,b;",
			"\tFrac():a{},b{1}{}",
			"\tFrac(const T&_a,const T&_b=1):a{_a},b{_b}{simplify();}",
			"\tstatic constexpr long double eps=1e-12l;",
			"\tstatic T gcd(T x,T y){",
			"\t\tif(x<0)x=-x;",
			"\t\tif(y<0)y=-y;",
			"\t\twhile(y){T t{x%y};x=y;y=t;}",
			"\t\treturn x;",
			"\t}",
			"\tstatic bool eq(const T&x,const T&y){",
			"\t\tif constexpr(std::is_same_v<T,long double>)return std::fabs(x-y)<eps;",
			"\t\treturn x==y;",
			"\t}",
			"\tvoid simplify(){",
			"\t\tif(b<0)a=-a,b=-b;",
			"\t\tif constexpr(std::is_same_v<T,long double>)return;",
			"\t\telse{",
			"\t\t\tT g{gcd(a<0?-a:a,b)};",
			"\t\t\tif(g>1)a/=g,b/=g;",
			"\t\t}",
			"\t}",
			"\texplicit operator bool()const{return !!a;}",
			"\tfriend Frac operator+(const Frac&x,const Frac&y){",
			"\t\treturn {x.a*y.b+y.a*x.b,x.b*y.b};",
			"\t}",
			"\tFrac&operator+=(const Frac&x){",
			"\t\t*this=*this+x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Frac operator-(const Frac&x){",
			"\t\treturn {-x.a,x.b};",
			"\t}",
			"\tfriend Frac operator-(const Frac&x,const Frac&y){",
			"\t\treturn {x.a*y.b-y.a*x.b,x.b*y.b};",
			"\t}",
			"\tFrac&operator-=(const Frac&x){",
			"\t\t*this=*this-x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Frac operator*(const Frac&x,const Frac&y){",
			"\t\treturn {x.a*y.a,x.b*y.b};",
			"\t}",
			"\tFrac&operator*=(const Frac&x){",
			"\t\t*this=*this*x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Frac operator/(const Frac&x,const Frac&y){",
			"\t\treturn {x.a*y.b,x.b*y.a};",
			"\t}",
			"\tFrac&operator/=(const Frac&x){",
			"\t\t*this=*this/x;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend bool operator<(const Frac&x,const Frac&y){",
			"\t\treturn x.a*y.b<y.a*x.b;",
			"\t}",
			"\tfriend bool operator<=(const Frac&x,const Frac&y){",
			"\t\treturn !(y<x);",
			"\t}",
			"\tfriend bool operator==(const Frac&x,const Frac&y){",
			"\t\treturn eq(x.a*y.b,y.a*x.b);",
			"\t}",
			"\tfriend bool operator!=(const Frac&x,const Frac&y){",
			"\t\treturn !(x==y);",
			"\t}",
			"\tfriend bool operator>=(const Frac&x,const Frac&y){",
			"\t\treturn !(x<y);",
			"\t}",
			"\tfriend bool operator>(const Frac&x,const Frac&y){",
			"\t\treturn y<x;",
			"\t}",
			"};",
			"/**",
			" * 维护多项式 $\\sum_{i=0}^{\\texttt{dt.size()}}\\texttt{dt[i]}x^i$ 相关的运算。",
			" * 有 operator+ operator+= operator-（一元运算符和二元运算符） operator-= operator* operator*= operator/ operator/= operator% operator%= operator< operator<= operator== operator!= operator>= operator>",
			" */",
			"template<typename T=Frac<Bint<__int128>>>",
			"class Poly{",
			"\tpublic:",
			"\tstd::vector<T>dt;",
			"\tvoid assign(size_t _n,const T&x){dt.assign(_n,x);}",
			"\tT&operator[](size_t i){return dt[i];}",
			"\tconst T&operator[](size_t i)const{return dt[i];}",
			"\tauto begin(){return dt.begin();}",
			"\tauto end(){return dt.end();}",
			"\tauto begin()const{return dt.begin();}",
			"\tauto end()const{return dt.end();}",
			"\tPoly(){}",
			"\tPoly(const std::vector<T>&_dt):dt{_dt}{}",
			"\tPoly(std::initializer_list<T>_dt):dt{_dt}{}",
			"\tPoly(const T&t):dt{t}{}",
			"\tstatic constexpr long double eps=1e-12l;",
			"\tstatic bool zero(const T&x){",
			"\t\tif constexpr(std::is_same_v<T,long double>)return std::fabs(x)<eps;",
			"\t\treturn !x;",
			"\t}",
			"\tstatic bool eq(const T&a,const T&b){",
			"\t\tif constexpr(std::is_same_v<T,long double>)return std::fabs(a-b)<eps;",
			"\t\treturn a==b;",
			"\t}",
			"\tvoid reload(){",
			"\t\twhile(!dt.empty()&&zero(dt.back()))dt.pop_back();",
			"\t\tif(dt.empty())dt.push_back({});",
			"\t}",
			"\tT operator()(T x)const{",
			"\t\tT r{};",
			"\t\tfor(size_t i=dt.size();i--;)r=r*x+dt[i];",
			"\t\treturn r;",
			"\t}",
			"\tfriend Poly operator+(const Poly&a,const Poly&b){",
			"\t\tPoly t{};",
			"\t\tt.dt.resize(std::max(a.dt.size(),b.dt.size()));",
			"\t\tfor(size_t i=0;i<t.dt.size();i++){",
			"\t\t\tif(i<a.dt.size())t.dt[i]+=a.dt[i];",
			"\t\t\tif(i<b.dt.size())t.dt[i]+=b.dt[i];",
			"\t\t}",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tPoly&operator+=(const Poly&b){",
			"\t\tif(dt.size()<b.dt.size())dt.resize(b.dt.size());",
			"\t\tfor(size_t i=0;i<b.dt.size();i++)dt[i]+=b.dt[i];",
			"\t\treload();",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Poly operator-(const Poly&a){",
			"\t\tPoly t{};",
			"\t\tt.dt.resize(a.dt.size());",
			"\t\tfor(size_t i=0;i<a.dt.size();i++)t.dt[i]=-a.dt[i];",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tfriend Poly operator-(const Poly&a,const Poly&b){",
			"\t\tPoly t{a};",
			"\t\tt-=b;",
			"\t\treturn t;",
			"\t}",
			"\tPoly&operator-=(const Poly&b){",
			"\t\tif(dt.size()<b.dt.size())dt.resize(b.dt.size());",
			"\t\tfor(size_t i=0;i<b.dt.size();i++)dt[i]-=b.dt[i];",
			"\t\treload();",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Poly operator*(const Poly&a,const Poly&b){",
			"\t\tPoly t{};",
			"\t\tt.dt.resize(a.dt.size()+b.dt.size()-1);",
			"\t\tfor(size_t i=0;i<a.dt.size();i++)",
			"\t\t\tfor(size_t j=0;j<b.dt.size();j++)",
			"\t\t\t\tt.dt[i+j]+=a.dt[i]*b.dt[j];",
			"\t\tt.reload();",
			"\t\treturn t;",
			"\t}",
			"\tPoly&operator*=(const Poly&b){",
			"\t\t*this=*this*b;",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Poly operator/(const Poly&a,const Poly&b){",
			"\t\tPoly t{a};",
			"\t\tt/=b;",
			"\t\treturn t;",
			"\t}",
			"\tPoly&operator/=(const Poly&b){",
			"\t\tPoly t{},r{*this};",
			"\t\tt.dt.resize(r.dt.size());",
			"\t\twhile(r.dt.size()>=b.dt.size()&&(r.dt.size()>1||!zero(r.dt[0]))){",
			"\t\t\tsize_t sh=r.dt.size()-b.dt.size();",
			"\t\t\tt.dt[sh]=r.dt.back()/b.dt.back();",
			"\t\t\tfor(size_t i=0;i<b.dt.size();i++)r.dt[sh+i]-=t.dt[sh]*b.dt[i];",
			"\t\t\tr.reload();",
			"\t\t}",
			"\t\t*this=std::move(t);",
			"\t\treload();",
			"\t\treturn *this;",
			"\t}",
			"\tfriend Poly operator%(const Poly&a,const Poly&b){",
			"\t\tPoly t{a};",
			"\t\tt%=b;",
			"\t\treturn t;",
			"\t}",
			"\tPoly&operator%=(const Poly&b){",
			"\t\t*this-=*this/b*b;",
			"\t\treload();",
			"\t\treturn *this;",
			"\t}",
			"\tfriend bool operator<(const Poly&a,const Poly&b){",
			"\t\tPoly x{a},y{b};",
			"\t\tx.reload();y.reload();",
			"\t\tif(x.dt.size()!=y.dt.size())return x.dt.size()<y.dt.size();",
			"\t\tfor(size_t i=x.dt.size();i--;)",
			"\t\t\tif(!eq(x.dt[i],y.dt[i]))return x.dt[i]<y.dt[i];",
			"\t\treturn false;",
			"\t}",
			"\tfriend bool operator<=(const Poly&a,const Poly&b){",
			"\t\treturn !(b<a);",
			"\t}",
			"\tfriend bool operator==(const Poly&a,const Poly&b){",
			"\t\tPoly x{a},y{b};",
			"\t\tx.reload();y.reload();",
			"\t\tif(x.dt.size()!=y.dt.size())return false;",
			"\t\tfor(size_t i=0;i<x.dt.size();i++)",
			"\t\t\tif(!eq(x.dt[i],y.dt[i]))return false;",
			"\t\treturn true;",
			"\t}",
			"\tfriend bool operator!=(const Poly&a,const Poly&b){",
			"\t\treturn !(a==b);",
			"\t}",
			"\tfriend bool operator>=(const Poly&a,const Poly&b){",
			"\t\treturn !(a<b);",
			"\t}",
			"\tfriend bool operator>(const Poly&a,const Poly&b){",
			"\t\treturn b<a;",
			"\t}",
			"};",
			"namespace std{",
			"\ttemplate<typename T>",
			"\tPoly<T>gcd(const Poly<T>&a,const Poly<T>&b){",
			"\t\tPoly<T>x{a},y{b};",
			"\t\tx.reload();y.reload();",
			"\t\twhile(y.dt.size()>1||!Poly<T>::zero(y.dt[0])){",
			"\t\t\tPoly<T>r{x%y};",
			"\t\t\tx=y;",
			"\t\t\ty=r;",
			"\t\t}",
			"\t\tif(x.dt.size()>1||!Poly<T>::zero(x.dt[0]))x/=Poly<T>{x.dt.back()};",
			"\t\treturn x;",
			"\t}",
			"}",
			"template<typename T>",
			"inline Poly<T>Deri(Poly<T>p){",
			"\tif(p.dt.size()==1){p.dt[0]={};return p;}",
			"\tfor(size_t i=1;i<p.dt.size();i++)p.dt[i-1]=p.dt[i]*T(i);",
			"\tp.dt.pop_back();",
			"\tp.reload();",
			"\treturn p;",
			"}",
			"template<typename T>",
			"inline Poly<T>inter(Poly<T>p){",
			"\tp.dt.push_back({});",
			"\tfor(size_t i=p.dt.size()-1;i--;)p.dt[i+1]=p.dt[i]/T(i+1);",
			"\tp.dt[0]={};",
			"\tp.reload();",
			"\treturn p;",
			"}",
			"template<typename T=__int128>",
			"inline Bint<T>readBint(){",
			"\tstd::string s{};",
			"\tchar c{getchar()};",
			"\twhile(c!=EOF&&(c<'0'||c>'9')&&c!='-')c=getchar();",
			"\tif(c=='-'){s+='-';c=getchar();}",
			"\twhile(c!=EOF&&!(c<'0'||c>'9')){s+=c;c=getchar();}",
			"\treturn Bint<T>{s};",
			"}",
			"template<typename T>",
			"inline __int128 isread(Bint<T>&t){",
			"\tbool f=0;char c=getchar();",
			"\twhile(c!=EOF&&(c<'0'||c>'9')){f=c=='-';c=getchar();}",
			"\tif(c==EOF)return -1;",
			"\tstd::string s{};",
			"\twhile(c!=EOF&&!(c<'0'||c>'9')){s+=c;c=getchar();}",
			"\tungetc(c,stdin);",
			"\tif(s.empty())return -1;",
			"\tt=Bint<T>{(f?\"-\":\"\")+s};",
			"\treturn 1;",
			"}",
			"template<typename T>",
			"inline __int128 isread(Frac<T>&t){",
			"\tauto from_str=[](const std::string&s){",
			"\t\tif constexpr(std::is_same_v<T,long double>)return std::stold(s);",
			"\t\telse return T{s};",
			"\t};",
			"\tchar c{(char)getchar()};",
			"\twhile(c!=EOF&&(c<'0'||c>'9')&&c!='-'&&c!='.')c=getchar();",
			"\tif(c==EOF)return -1;",
			"\tbool neg=0;",
			"\tif(c=='-'){",
			"\t\tneg=1;",
			"\t\tc=getchar();",
			"\t}",
			"\tif(c==EOF)return -1;",
			"\tstd::string ip{},fp{},dp{};",
			"\tif(c!='.'){",
			"\t\twhile(c!=EOF&&!(c<'0'||c>'9')){ip+=c;c=getchar();}",
			"\t}",
			"\tif(c=='.'){",
			"\t\tc=getchar();",
			"\t\twhile(c!=EOF&&!(c<'0'||c>'9')){fp+=c;c=getchar();}",
			"\t}",
			"\tif(c=='/'){",
			"\t\tc=getchar();",
			"\t\twhile(c!=EOF&&!(c<'0'||c>'9')){dp+=c;c=getchar();}",
			"\t}",
			"\tif(c!=EOF)ungetc(c,stdin);",
			"\tif(ip.empty()&&fp.empty())return -1;",
			"\tif(ip.empty())ip=\"0\";",
			"\tT num{from_str(ip+fp)},den{1};",
			"\tfor(size_t i=0;i<fp.size();i++)den*=10;",
			"\tif(!dp.empty())den*=from_str(dp);",
			"\tt=Frac<T>{neg?-num:num,den};",
			"\treturn 1;",
			"}",
			"template<typename T>",
			"inline __int128 isread(Poly<T>&p){",
			"\tstd::vector<T>v{};",
			"\twhile(true){",
			"\t\tchar c=getchar();",
			"\t\twhile(c!=EOF&&c!='\\n'&&(c<'0'||c>'9')&&c!='-'&&c!='.')c=getchar();",
			"\t\tif(c==EOF||c=='\\n')break;",
			"\t\tungetc(c,stdin);",
			"\t\tT t{};",
			"\t\tif(isread(t)==-1)break;",
			"\t\tv.push_back(std::move(t));",
			"\t}",
			"\tif(v.empty())return -1;",
			"\tp.dt=std::move(v);",
			"\treturn 1;",
			"}",
			"template<typename T>",
			"inline void write(const Bint<T>&t){",
			"\tif(t.sig)putchar('-');",
			"\tprintf(\"%d\",(int)t.dt.back());",
			"\tfor(size_t i=t.dt.size()-1;i--;)printf(\"%09d\",(int)t.dt[i]);",
			"}",
			"template<typename T>",
			"inline void write(const Frac<T>&t){",
			"\tif(t.a<0){putchar('-');write(Frac<T>{-t.a,t.b});return;}",
			"\twrite(t.a/t.b);",
			"\tT r{t.a%t.b};",
			"\tif(!r)return;",
			"\tputchar('.');",
			"\tstd::map<T,size_t>pos;",
			"\tstd::vector<int>dig;",
			"\twhile(r&&!pos.count(r)){",
			"\t\tpos[r]=dig.size();",
			"\t\tr*=10;",
			"\t\tint d{};",
			"\t\tif constexpr(std::is_same_v<T,Bint<__int128>>)d=(int)(r/t.b).dt[0];",
			"\t\telse d=(int)(r/t.b);",
			"\t\tdig.push_back(d);",
			"\t\tr%=t.b;",
			"\t}",
			"\tif(!r){",
			"\t\tfor(int c:dig)putchar('0'+c);",
			"\t}else{",
			"\t\tsize_t st{pos[r]},L{dig.size()-st};",
			"\t\tfor(size_t i=0;i<st+2*L;i++)",
			"\t\t\tputchar('0'+dig[i<dig.size()?i:st+(i-st)%L]);",
			"\t\tputchar('.');putchar('.');putchar('.');",
			"\t}",
			"}",
			"template<typename T>",
			"inline void write(const Poly<T>&p){",
			"\tputchar('P');putchar('{');",
			"\tfor(size_t i=0;i<p.dt.size();i++){",
			"\t\tif(i)putchar(',');",
			"\t\twrite(p.dt[i]);",
			"\t}",
			"\tputchar('}');",
			"}"
		],
		"description": "poly.h"
	},
