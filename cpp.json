	"KMP": {
		"prefix": "KMP",
		"body": [
			"template<typename T=__int128>",
			"std::vector<T>pi_func(std::string s){",
			"\tT n=(T)s.length();",
			"\tstd::vector<T>pi(n);",
			"\tfor(T i=1;i<n;i++){",
			"\t\tT j=pi[i-1];",
			"\t\twhile(j>0&&s[i]!=s[j])j=pi[j-1];",
			"\t\tif(s[i]==s[j])j++;",
			"\t\tpi[i]=j;",
			"\t}",
			"\treturn pi;",
			"}",
			"template<typename T=__int128>",
			"std::vector<T>KMP(std::string S,std::string P){",
			"\tstd::string tmp=P+'\\x7f'+S;",
			"\tT ns=S.size(),nt=P.size();",
			"\tstd::vector<T>v;",
			"\tstd::vector<T>lps=pi_func(tmp);",
			"\tfor(T i=nt+1;i<=ns+nt;i++)if(lps[i]==nt)v.push_back(i-2*nt);",
			"\treturn v;",
			"}"
		],
		"description": "KMP 字符串匹配"
	},
