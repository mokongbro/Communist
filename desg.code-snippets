{
	"Dseg.h": {
		"prefix": "dseg",
		"body": [
			"#ifndef D_SEG_H",
			"#define D_SEG_H",
			"using i128=__int128;",
			"using u128=unsigned __int128;",
			"#include<stdio.h>",
			"template<typename T=__int128>",
			"inline T read(){T t{};bool f=0;char c=getchar();",
			"\twhile(c!=EOF&&(c<'0'||c>'9'))f=c=='-',c=getchar();",
			"\twhile(c!=EOF&&!(c<'0'||c>'9'))t*=10,t+=c-'0',c=getchar();",
			"\treturn f?-t:t;",
			"}",
			"template<typename T>",
			"inline void write(T t){",
			"\tif(t<0)putchar('-'),t=-t;",
			"\tif(t>9)write(t/10);",
			"\tputchar(t%10+'0');",
			"}",
			"#include<vector>",
			"#include<algorithm>",
			"inline i128 mod(i128 x,i128 m){return x%m;}",
			"const i128 INF=(static_cast<i128>(1)<<126)+((static_cast<i128>(1)<<126)-1);",
			"const i128 NEG=-INF-1;",
			"class Info{",
			"\tpublic:",
			"\ti128 l{},r{},d{};",
			"\tInfo(const i128&_l=0,const i128&_r=0,const i128&_d=0):l(_l),r(_r),d(_d){};",
			"};",
			"class Seg{",
			"\tclass nd{",
			"\t\tpublic:",
			"\t\ti128 sum{},tagp{},tagm{1},lc{NEG},rc{NEG};",
			"\t\tnd():sum{},tagp{},tagm{1},lc{NEG},rc{NEG}{}",
			"\t};",
			"\tstd::vector<nd>dt;",
			"\ti128 L{},R{},MOD{INF};",
			"\tpublic:",
			"\tSeg():L{},R{},MOD{INF}{}",
			"\tvoid build(i128 n){L=1;R=n;if(!dt.size())dt.emplace_back();}",
			"\tvoid build(i128 _L,i128 _R){L=_L;R=_R;if(!dt.size())dt.emplace_back();}",
			"\tvoid setMod(i128 _m){MOD=_m;}",
			"\tvoid clear(){dt.clear();L=0;R=0;MOD=INF;}",
			"\tsize_t size(){",
			"\t\treturn dt.size();",
			"\t}",
			"\tconst i128&newNd(i128&u,const i128&val=0){",
			"\t\tif(u!=NEG)return u;",
			"\t\tu=size();",
			"\t\tdt.emplace_back();",
			"\t\tdt.back().sum=val;",
			"\t\treturn u;",
			"\t}",
			"\tvoid upd(const i128&u,const i128&s,const i128&t,const i128&m){",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tdt[lc].sum=mod(dt[lc].sum*dt[u].tagm+(m-s+1)*dt[u].tagp,MOD);",
			"\t\tdt[rc].sum=mod(dt[rc].sum*dt[u].tagm+(t-m)*dt[u].tagp,MOD);",
			"\t\tdt[lc].tagm=mod(dt[lc].tagm*dt[u].tagm,MOD);",
			"\t\tdt[rc].tagm=mod(dt[rc].tagm*dt[u].tagm,MOD);",
			"\t\tdt[lc].tagp=mod(dt[lc].tagp*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\tdt[rc].tagp=mod(dt[rc].tagp*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\tdt[u].tagm=1;dt[u].tagp=0;",
			"\t}",
			"\tvoid add(const i128&d,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].sum=mod(dt[u].sum+(t-s+1)*d,MOD);",
			"\t\t\tdt[u].tagp=mod(dt[u].tagp+d,MOD);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tnewNd(dt[u].lc,0);newNd(dt[u].rc,0);",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)add(d,lc,l,r,s,m);",
			"\t\tif(r>m)add(d,rc,l,r,m+1,t);",
			"\t\tdt[u].sum=mod(dt[lc].sum+dt[rc].sum,MOD);",
			"\t}",
			"\tvoid add(const i128&l,const i128&r,const i128&x){",
			"\t\tadd(x,0,l,r,L,R);",
			"\t}",
			"\tvoid mul(const i128&d,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].sum=mod(dt[u].sum*d,MOD);",
			"\t\t\tdt[u].tagp=mod(dt[u].tagp*d,MOD);",
			"\t\t\tdt[u].tagm=mod(dt[u].tagm*d,MOD);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tnewNd(dt[u].lc);newNd(dt[u].rc);",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)mul(d,lc,l,r,s,m);",
			"\t\tif(r>m)mul(d,rc,l,r,m+1,t);",
			"\t\tdt[u].sum=mod(dt[lc].sum+dt[rc].sum,MOD);",
			"\t}",
			"\tvoid mul(const i128&l,const i128&r,const i128&x){",
			"\t\tmul(x,0,l,r,L,R);",
			"\t}",
			"\ti128 query(const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return 0;",
			"\t\tif(l<=s&&t<=r)return dt[u].sum;",
			"\t\ti128 ans{};",
			"\t\tnewNd(dt[u].lc);newNd(dt[u].rc);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tif(l<=m)ans=mod(ans+query(lc,l,r,s,m),MOD);",
			"\t\tif(r>m)ans=mod(ans+query(rc,l,r,m+1,t),MOD);",
			"\t\treturn ans;",
			"\t}",
			"\ti128 query(const i128&l,const i128&r){",
			"\t\treturn query(0,l,r,L,R);",
			"\t}",
			"\t//求第k大的数，此函数假设Seg是一个桶。",
			"\ti128 find(const i128&k,const i128&u,const i128&s,const i128&t){",
			"\t\tif(s==t)return s;",
			"\t\tnewNd(dt[u].lc);newNd(dt[u].rc);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tif(k<=0)return s;",
			"\t\tif(k<=dt[rc].sum)return find(k,rc,m+1,t);",
			"\t\tif(k<=dt[rc].sum+dt[lc].sum)return find(k-dt[rc].sum,lc,s,m);",
			"\t\treturn t;",
			"\t}",
			"\ti128 find(const i128&k){",
			"\t\treturn find(k,0,L,R);",
			"\t}",
			"\tvoid reset(const i128&x,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].sum=mod((t-s+1)*x,MOD);",
			"\t\t\tdt[u].tagm=0;dt[u].tagp=mod(x,MOD);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tnewNd(dt[u].lc);newNd(dt[u].rc);",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)reset(x,lc,l,r,s,m);",
			"\t\tif(r>m)reset(x,rc,l,r,m+1,t);",
			"\t\tdt[u].sum=mod(dt[lc].sum+dt[rc].sum,MOD);",
			"\t}",
			"\tvoid reset(const i128&l,const i128&r,const i128&x){",
			"\t\treset(x,0,l,r,L,R);",
			"\t}",
			"\tSeg&operator+=(Info p){",
			"\t\tadd(p.l,p.r,p.d);",
			"\t\treturn *this;",
			"\t}",
			"\tSeg&operator*=(Info p){",
			"\t\tmul(p.l,p.r,p.d);",
			"\t\treturn *this;",
			"\t}",
			"\ti128 operator()(i128 l,i128 r){",
			"\t\treturn query(l,r);",
			"\t}",
			"\ti128 operator[](const i128&k){",
			"\t\treturn find(k);",
			"\t}",
			"\tvoid operator=(Info p){",
			"\t\treset(p.l,p.r,p.d);",
			"\t}",
			"};",
			"class maxmin_Seg{",
			"\tclass nd{",
			"\t\tpublic:",
			"\t\ti128 mx{NEG},mn{INF},tagp{},tagm{1},lc{NEG},rc{NEG};",
			"\t\tnd():mx{NEG},mn{INF},tagp{},tagm{1},lc{NEG},rc{NEG}{}",
			"\t\tvoid swapm(){if(mx<mn)std::swap(mx,mn);}",
			"\t};",
			"\tstd::vector<nd>dt;",
			"\ti128 L{},R{},MOD{INF};",
			"\tpublic:",
			"\tmaxmin_Seg():L{},R{},MOD{INF}{}",
			"\tvoid build(i128 n){L=1;R=n;if(!dt.size())dt.emplace_back();}",
			"\tvoid build(i128 _L,i128 _R){L=_L;R=_R;if(!dt.size())dt.emplace_back();}",
			"\tvoid setMod(i128 _m){MOD=_m;}",
			"\tvoid clear(){dt.clear();L=0;R=0;MOD=INF;}",
			"\tsize_t size(){",
			"\t\treturn dt.size();",
			"\t}",
			"\tconst i128&newNd(i128&u,const i128&pmx=0,const i128&pmn=0){",
			"\t\tif(u!=NEG)return u;",
			"\t\tu=size();",
			"\t\tdt.emplace_back();",
			"\t\tdt.back().mx=pmx;dt.back().mn=pmn;",
			"\t\treturn u;",
			"\t}",
			"\tvoid upd(const i128&u,const i128&s,const i128&t,const i128&m){",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(lc!=NEG){",
			"\t\t\tdt[lc].mx=mod(dt[lc].mx*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t\tdt[lc].mn=mod(dt[lc].mn*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t\tdt[lc].swapm();",
			"\t\t\tdt[lc].tagm=mod(dt[lc].tagm*dt[u].tagm,MOD);",
			"\t\t\tdt[lc].tagp=mod(dt[lc].tagp*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t}",
			"\t\tif(rc!=NEG){",
			"\t\t\tdt[rc].mx=mod(dt[rc].mx*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t\tdt[rc].mn=mod(dt[rc].mn*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t\tdt[rc].swapm();",
			"\t\t\tdt[rc].tagm=mod(dt[rc].tagm*dt[u].tagm,MOD);",
			"\t\t\tdt[rc].tagp=mod(dt[rc].tagp*dt[u].tagm+dt[u].tagp,MOD);",
			"\t\t}",
			"\t\tdt[u].tagm=1;dt[u].tagp=0;",
			"\t}",
			"\tvoid add(const i128&d,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].mx=mod(dt[u].mx+d,MOD);",
			"\t\t\tdt[u].mn=mod(dt[u].mn+d,MOD);",
			"\t\t\tdt[u].tagp=mod(dt[u].tagp+d,MOD);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tnewNd(dt[u].lc,dt[u].mx,dt[u].mn);newNd(dt[u].rc,dt[u].mx,dt[u].mn);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)add(d,lc,l,r,s,m);",
			"\t\tif(r>m)add(d,rc,l,r,m+1,t);",
			"\t\tdt[u].mx=std::max(dt[lc].mx,dt[rc].mx);",
			"\t\tdt[u].mn=std::min(dt[lc].mn,dt[rc].mn);",
			"\t}",
			"\tvoid add(const i128&l,const i128&r,const i128&x){",
			"\t\tadd(x,0,l,r,L,R);",
			"\t}",
			"\tvoid mul(const i128&d,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].mx=mod(dt[u].mx*d,MOD);",
			"\t\t\tdt[u].mn=mod(dt[u].mn*d,MOD);",
			"\t\t\tdt[u].tagp=mod(dt[u].tagp*d,MOD);",
			"\t\t\tdt[u].tagm=mod(dt[u].tagm*d,MOD);",
			"\t\t\tdt[u].swapm();",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tnewNd(dt[u].lc,dt[u].mx,dt[u].mn);newNd(dt[u].rc,dt[u].mx,dt[u].mn);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)mul(d,lc,l,r,s,m);",
			"\t\tif(r>m)mul(d,rc,l,r,m+1,t);",
			"\t\tdt[u].mx=std::max(dt[lc].mx,dt[rc].mx);",
			"\t\tdt[u].mn=std::min(dt[lc].mn,dt[rc].mn);",
			"\t}",
			"\tvoid mul(const i128&l,const i128&r,const i128&x){",
			"\t\tmul(x,0,l,r,L,R);",
			"\t}",
			"\ti128 querymx(const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return NEG;",
			"\t\tif(l<=s&&t<=r)return dt[u].mx;",
			"\t\ti128 ans=NEG;",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tnewNd(dt[u].lc,dt[u].mx,dt[u].mn);newNd(dt[u].rc,dt[u].mx,dt[u].mn);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)(ans=std::max(ans,querymx(lc,l,r,s,m)));",
			"\t\tif(r>m)(ans=std::max(ans,querymx(rc,l,r,m+1,t)));",
			"\t\treturn ans;",
			"\t}",
			"\ti128 querymx(const i128&l,const i128&r){",
			"\t\treturn querymx(0,l,r,L,R);",
			"\t}",
			"\ti128 querymn(const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return INF;",
			"\t\tif(l<=s&&t<=r)return dt[u].mn;",
			"\t\ti128 ans=INF;",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tnewNd(dt[u].lc,dt[u].mx,dt[u].mn);newNd(dt[u].rc,dt[u].mx,dt[u].mn);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)(ans=std::min(ans,querymn(lc,l,r,s,m)));",
			"\t\tif(r>m)(ans=std::min(ans,querymn(rc,l,r,m+1,t)));",
			"\t\treturn ans;",
			"\t}",
			"\ti128 querymn(const i128&l,const i128&r){",
			"\t\treturn querymn(0,l,r,L,R);",
			"\t}",
			"\tvoid reset(const i128&x,const i128&u,const i128&l,const i128&r,const i128&s,const i128&t){",
			"\t\tif(t<l||r<s)return;",
			"\t\tif(l<=s&&t<=r){",
			"\t\t\tdt[u].mx=mod(x,MOD);dt[u].mn=mod(x,MOD);",
			"\t\t\tdt[u].tagm=0;dt[u].tagp=mod(x,MOD);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tauto m=(s+t)>>1;",
			"\t\tif(dt[u].tagm!=1||dt[u].tagp!=0)upd(u,s,t,m);",
			"\t\tnewNd(dt[u].lc,dt[u].mx,dt[u].mn);newNd(dt[u].rc,dt[u].mx,dt[u].mn);",
			"\t\tauto lc=dt[u].lc,rc=dt[u].rc;",
			"\t\tif(l<=m)reset(x,lc,l,r,s,m);",
			"\t\tif(r>m)reset(x,rc,l,r,m+1,t);",
			"\t\tdt[u].mx=std::max(dt[lc].mx,dt[rc].mx);",
			"\t\tdt[u].mn=std::min(dt[lc].mn,dt[rc].mn);",
			"\t}",
			"\tvoid reset(const i128&l,const i128&r,const i128&x){",
			"\t\treset(x,0,l,r,L,R);",
			"\t}",
			"\tmaxmin_Seg&operator+=(Info p){",
			"\t\tadd(p.l,p.r,p.d);",
			"\t\treturn *this;",
			"\t}",
			"\tmaxmin_Seg&operator*=(Info p){",
			"\t\tmul(p.l,p.r,p.d);",
			"\t\treturn *this;",
			"\t}",
			"\ti128 operator()(i128 l,i128 r,i128 op){",
			"\t\tif(op>0)return querymx(l,r);",
			"\t\telse if(op<0)return querymn(l,r);",
			"\t\telse return 0;",
			"\t}",
			"\tvoid operator=(Info p){",
			"\t\treset(p.l,p.r,p.d);",
			"\t}",
			"};",
			"#endif"
		],
		"description": "Dseg.h header for segment tree"
	}
}